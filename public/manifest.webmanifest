{
  "name": "VYBE",
  "short_name": "VYBE",
  "description": "A social app that actually feels alive.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0B0B10",
  "theme_color": "#8B5CF6",
  "lang": "en",
  "categories": ["social", "entertainment", "lifestyle"],
  "icons": [
    {
      "src": "/icons/vybe-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/vybe-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/vybe-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icons/vybe-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Messages",
      "short_name": "Chat",
      "description": "Open your messages",
      "url": "/messages",
      "icons": [{ "src": "/icons/vybe-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Create Post",
      "short_name": "Post",
      "description": "Create a new post",
      "url": "/upload",
      "icons": [{ "src": "/icons/vybe-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Explore",
      "short_name": "Explore",
      "description": "Discover new content",
      "url": "/explore",
      "icons": [{ "src": "/icons/vybe-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Notifications",
      "short_name": "Alerts",
      "description": "Check your notifications",
      "url": "/notifications",
      "icons": [{ "src": "/icons/vybe-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Profile",
      "short_name": "Me",
      "description": "View your profile",
      "url": "/profile",
      "icons": [{ "src": "/icons/vybe-192.png", "sizes": "192x192" }]
    }
  ],
  "protocol_handlers": [
    {
      "protocol": "web+vybe",
      "url": "/%s"
    }
  ],
  "related_applications": [
    {
      "platform": "play",
