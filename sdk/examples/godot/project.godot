config_version=5

[application]
config/name="Vybe game capture example"
run/main_scene="res://Main.tscn"
config/features=PackedStringArray("4.5", "C#", "GL Compatibility")

[display]
window/size/viewport_width=960
window/size/viewport_height=800
window/stretch/mode="canvas_items"

[dotnet]
project/assembly_name="VybeGodot"

[rendering]
renderer/rendering_method="gl_compatibility"
environment/defaults/default_clear_color=Color(0.045, 0.035, 0.085, 1)

[vybe]
; Set only trusted operator configuration. No secrets belong here.
api_endpoint=""
client_id=""
allow_local_emulator=false
