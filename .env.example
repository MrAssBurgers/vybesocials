# VYBE — environment variables (example)
# Real .env is auto-managed by Lovable Cloud. Use this file as documentation
# for any contributor running the project outside the Lovable sandbox.

# Auto-managed by Lovable — do not set manually:
#   VITE_SUPABASE_URL
#   VITE_SUPABASE_PROJECT_ID
#   VITE_SUPABASE_PUBLISHABLE_KEY

# WebAuthn / Passkeys — documentation only.
# The production RP ID is hardcoded in
# supabase/functions/_shared/passkey-rp.ts (PROD_RP_ID = 'vybehub.app').
# These vars exist so future contributors can override without editing
# the edge function.
VITE_PUBLIC_WEBAUTHN_RP_ID=vybehub.app
VITE_PUBLIC_WEBAUTHN_RP_NAME=VYBE

# Edge-function secrets (set in Lovable Cloud → Backend → Secrets):
#   RESEND_API_KEY        — required for password reset / verification email
#   RESEND_FROM_EMAIL     — optional, defaults to onboarding@resend.dev
#   LOVABLE_API_KEY       — auto-managed (AI Gateway)
