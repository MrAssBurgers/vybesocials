# VYBE — environment variables (example)
# Copy to `.env` for local dev. Never commit `.env`.

# Firebase — project vybe-daaab
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=vybe-daaab.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=vybe-daaab
VITE_FIREBASE_STORAGE_BUCKET=vybe-daaab.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=728651793473
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_FUNCTIONS_REGION=us-central1
VITE_FIREBASE_VAPID_KEY=

# Despia native OAuth (Google sign-in in App Store / Play Store builds)
# VITE_DESPIA_DEEPLINK_SCHEME=com.despia.vybe
# VITE_FIREBASE_GOOGLE_WEB_CLIENT_ID=728651793473-....apps.googleusercontent.com

# Mapbox — VybeMap 3D / satellite / terrain (https://account.mapbox.com/access-tokens/)
VITE_MAPBOX_ACCESS_TOKEN=

# App Check (required before enforcing Firebase AI Logic in production)
VITE_FIREBASE_APP_CHECK_RECAPTCHA_SITE_KEY=
# enterprise (default) or v3 — must match Firebase Console App Check provider
# VITE_FIREBASE_APP_CHECK_PROVIDER=enterprise
# Register debug token in Firebase Console → App Check (works in prod builds too)
# VITE_FIREBASE_APP_CHECK_DEBUG_TOKEN=

# WebAuthn / Passkeys
VITE_PUBLIC_WEBAUTHN_RP_ID=vybehub.app
VITE_PUBLIC_WEBAUTHN_RP_NAME=VYBE

# Offline strategy
VITE_OFFLINE_MODE=pwa

# Maintenance — set true + Lovable Publish to show reconstruction screen to all visitors
VITE_MAINTENANCE_MODE=false
# VITE_MAINTENANCE_MESSAGE=Custom message shown on the maintenance screen (optional)

# ─── Cloud Functions / server secrets (local only — synced from Firebase or paste manually) ───
# Used by: npm run setup:gemini-secrets, functions emulators, local scripts
# NEVER commit real values. Production uses Firebase Secret Manager, not Lovable client env.
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# GIPHY_API_KEY=
# PIXABAY_API_KEY=
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
# LIVEKIT_URL=
# ONESIGNAL_APP_ID=
# ONESIGNAL_REST_API_KEY=
# RESEND_API_KEY=
# EMAIL_FROM=
# PUBLIC_SITE_URL=https://vybehub.app
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_WEBHOOK_SECRET_THIN=

# Cloud Functions secrets (Firebase Console → Functions → Secrets):
#   GEMINI_API_KEY — required (AI + Vybe Check borderline review)
#   OPENAI_API_KEY — required for Vybe Check text moderation + video STT (set secret, add to startVybeCheck SECRETS, redeploy)
#   PUBLIC_SITE_URL — optional, default https://vybehub.app (password reset continue URL)
#   SPOTIFY_CLIENT_ID — Spotify OAuth (Settings → Connections)
#   SPOTIFY_CLIENT_SECRET — Spotify OAuth
#
# Spotify setup (any ONE of these — never commit secrets):
#   SPOTIFY_CLIENT_ID=xxx SPOTIFY_CLIENT_SECRET=yyy npm run setup:spotify-secrets
#   npm run setup:spotify-secrets -- --client-id=xxx --client-secret=yyy
# Register redirect URI in Spotify Dashboard: https://vybehub.app/spotify/callback
#
# Stripe (Firebase Functions secrets — never commit sk_live / whsec):
#   STRIPE_SECRET_KEY=sk_live_... npm run setup:stripe-secrets
# Optional: STRIPE_PUBLISHABLE_KEY=pk_live_... (also upserts Firestore stripe_config)
# Webhook URLs after deploy: us-central1-vybe-daaab.cloudfunctions.net/stripeWebhook
#
# ONESIGNAL_APP_ID=85bcf4b4-16fb-4101-90b3-59ca9574e57b
# ONESIGNAL_REST_API_KEY=
#
# OneSignal MCP in Cursor (optional — or use Settings → MCP → Authenticate):
#   npm run setup:onesignal-mcp
# See .cursor/ONESIGNAL_MCP.md
# Password reset emails use Firebase Auth templates (not Resend). Sync branded HTML:
#   GOOGLE_APPLICATION_CREDENTIALS=./secrets/firebase-admin.json npm run firebase:sync-email-templates
