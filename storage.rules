rules_version = '2';

// VYBE Storage rules — ported from Supabase bucket policies.
service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }
    function isOwner(userId) { return signedIn() && request.auth.uid == userId; }
    function smallEnough() { return request.resource.size < 50 * 1024 * 1024; }
    function isImage() { return request.resource.contentType.matches('image/.*'); }
    function isAv() { return request.resource.contentType.matches('(image|video|audio)/.*'); }

    // Per-user owned buckets
    match /avatars/{userId}/{allPaths=**} {
      allow read: if signedIn();
      allow create, update: if isOwner(userId) && smallEnough() && isImage();
      allow delete: if isOwner(userId);
    }
    match /media/{userId}/{allPaths=**} {
      allow read: if signedIn();
      allow create, update: if isOwner(userId) && smallEnough() && isAv();
      allow delete: if isOwner(userId);
    }
    match /stories/{userId}/{allPaths=**} {
      allow read: if signedIn();
      allow create, update: if isOwner(userId) && smallEnough() && isAv();
      allow delete: if isOwner(userId);
    }
    // Private DM media. Direct read is restricted to the uploader; recipients
    // must fetch via a Cloud Function that issues short-lived signed URLs
    // after verifying conversation membership server-side.
    match /chat-media/{userId}/{allPaths=**} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update: if isOwner(userId) && smallEnough() && isAv();
      allow delete: if isOwner(userId) || isAdmin();
    }
    match /clips/{userId}/{allPaths=**} {
      allow read: if signedIn();
      allow create, update: if isOwner(userId) && smallEnough();
      allow delete: if isOwner(userId);
    }
    match /post-media/{userId}/{allPaths=**} {
      allow read: if signedIn();
      allow create, update: if isOwner(userId) && smallEnough() && isAv();
      allow delete: if isOwner(userId);
    }
    match /community-assets/{userId}/{allPaths=**} {
      allow read: if signedIn();
      allow create, update: if isOwner(userId) && smallEnough();
      allow delete: if isOwner(userId);
    }
    match /announcements/{allPaths=**} {
      allow read: if signedIn();
      allow create, update: if isAdmin() && smallEnough();
      allow delete: if isAdmin();
    }

    // Public reference assets (write via admin SDK only)
    match /public/{allPaths=**} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Game uploads stay private until the owner reviews them in VYBE.
    // Session documents are created only by the game integration callables.
    match /game-captures/{userId}/{captureId} {
      function capture() {
        return firestore.get(/databases/(default)/documents/game_captures/$(captureId)).data;
      }
      allow read: if isOwner(userId)
        && capture().owner_uid == request.auth.uid
        && capture().expires_at_ms > request.time.toMillis()
        && capture().status in ['uploading', 'ready'];
      allow create: if isOwner(userId)
        && resource == null
        && request.resource.size > 0
        && request.resource.size <= 48 * 1024 * 1024
        && capture().owner_uid == request.auth.uid
        && !('partner_connection_id' in capture())
        && capture().status == 'uploading'
        && capture().expires_at_ms > request.time.toMillis()
        && request.resource.size == capture().byte_size
        && request.resource.contentType == capture().content_type
        && request.resource.contentType in ['image/png', 'image/jpeg', 'image/webp', 'video/mp4', 'video/webm'];
      // Immutable media prevents replacing a file after its server validation.
      allow update, delete: if false;
    }

    // Partner tokens authorize only HTTP chunk endpoints, never Firebase Storage.
    match /game-partner-staging/{allPaths=**} {
      allow read, write: if false;
    }

    // Default deny
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
